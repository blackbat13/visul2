---
title: Wyszukiwanie trójkowe
ternary_search: active
alg: prepareTernarySearch
name: ternary_search
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{% if locale == 'en' %}en/searching/ternary_search/index.html{% else %}searching/ternary_search/index.html{% endif %}"
---
{% assign copy = simulation[locale] %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    {% include "_visul_head.liquid" %}
    <link rel="stylesheet" type="text/css" href="{{ '/assets/css/searching.css' | url }}"/>
</head>
<body class="binary-search-page">
<div class="container-fluid">
    {% include "_searching_nav.liquid" %}

    {% include "_visul_container.liquid" %}

    <div class="row controls-row ps-2">
        <div class="col-4">
            {% include "_binary_search_settings.liquid" %}
            {% include "_linear_search_settings.liquid" %}
        </div>
        <div class="col-4 controls-div">
            {% include "_visul_sim_controls.liquid" %}
        </div>
        <div class="col-4">
            {% include "_alg_ternary_search.liquid" %}
        </div>
    </div>
</div>

{% include "_visul_scripts.liquid" %}
{% include "_searching_script.liquid" %}
</body>
</html>
