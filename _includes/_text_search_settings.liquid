<div class="row col-12 mt-3">
    <label for="text-input" class="col-12 col-form-label">{{ copy.labels.text }}</label>
    <div class="col-12">
        <input id="text-input" type="text" class="form-control" maxlength="40" required value="ABABDABACDABABCABAB"/>
    </div>
</div>
<div class="row col-12 mt-3">
    <label for="pattern-input" class="col-12 col-form-label">{{ copy.labels.pattern }}</label>
    <div class="col-12">
        <input id="pattern-input" type="text" class="form-control" maxlength="40" required value="ABABCABAB"/>
    </div>
</div>
<div class="col-12 mt-2">
    <button id="apply-text-search-button" type="button" class="btn btn-outline-primary">
        <i class="fa fa-check" aria-hidden="true"></i> {{ copy.labels.applyTextSearch }}
    </button>
</div>
<p id="search-result" class="mt-3" aria-live="polite"></p>
