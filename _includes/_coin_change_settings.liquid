<div class="row col-12 mt-3">
    <label for="coin-change-coins-input" class="col-12 col-form-label">{{ copy.labels.coinDenominations }}</label>
    <div class="col-12">
        <input id="coin-change-coins-input" type="text" class="form-control" maxlength="32" value="1, 3, 4"/>
    </div>
</div>
<div class="row col-12 mt-3">
    <label for="coin-change-amount-input" class="col-12 col-form-label">{{ copy.labels.coinTargetAmount }}</label>
    <div class="col-12">
        <input id="coin-change-amount-input" type="number" class="form-control" min="0" max="15" step="1" value="6"/>
    </div>
</div>
<p class="mt-2 mb-0">{{ copy.labels.coinChangeInputHelp }}</p>
<div class="col-12 mt-2">
    <button id="apply-coin-change-button" type="button" class="btn btn-outline-primary">
        <i class="fa fa-check" aria-hidden="true"></i> {{ copy.labels.applyCoinChange }}
    </button>
</div>
<p id="search-result" class="mt-3" aria-live="polite"></p>
