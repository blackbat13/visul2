<div class="row col-12 mt-3">
    <label for="lcs-first-input" class="col-12 col-form-label">{{ copy.labels.firstSequence }}</label>
    <div class="col-12">
        <input id="lcs-first-input" type="text" class="form-control" maxlength="12" required value="AGGTAB"/>
    </div>
</div>
<div class="row col-12 mt-3">
    <label for="lcs-second-input" class="col-12 col-form-label">{{ copy.labels.secondSequence }}</label>
    <div class="col-12">
        <input id="lcs-second-input" type="text" class="form-control" maxlength="12" required value="GXTXAYB"/>
    </div>
</div>
<p class="mt-2 mb-0">{{ copy.labels.sequenceLengthHelp }}</p>
<div class="col-12 mt-2">
    <button id="apply-lcs-button" type="button" class="btn btn-outline-primary">
        <i class="fa fa-check" aria-hidden="true"></i> {{ copy.labels.applyLcs }}
    </button>
</div>
<p id="search-result" class="mt-3" aria-live="polite"></p>
