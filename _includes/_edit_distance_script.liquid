<script>
    $(document).ready(function () {
        let algorithms = new DynamicAlgorithms();
        let $firstInput = $("#edit-distance-first-input");
        let $secondInput = $("#edit-distance-second-input");

        function prepareSimulation() {
            algorithms.prepareLevenshteinDistance($firstInput.val(), $secondInput.val());
        }

        renderPseudocode();
        prepareSimulation();
        algorithms.bindControls();

        $("#apply-edit-distance-button").click(prepareSimulation);
        $firstInput.add($secondInput).on("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                prepareSimulation();
            }
        });
    });
</script>
