<pre id="pseudocode" style="display : none;">
    \begin{algorithm}
    \caption{LinearSearch}
    \begin{algorithmic}
    \FUNCTION{LinearSearch}{A, n, target}
        \FOR{$i \gets 0$ \TO $n - 1$}
            \IF{$A[i] = target$}
                \RETURN $i$
            \ENDIF
        \ENDFOR
        \RETURN $-1$
    \ENDFUNCTION
    \end{algorithmic}
    \end{algorithm}
</pre>