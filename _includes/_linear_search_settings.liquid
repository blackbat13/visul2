<div class="row col-12 mt-3">
    <label for="search-target" class="col-8 col-form-label">Wyszukiwany element:</label>
    <div class="col-4">
        <input id="search-target" type="number" class="form-control" min="1" max="15" step="1" required/>
    </div>
</div>
<div class="col-12 mt-2">
    <button id="random-search-target-button" type="button" class="btn btn-outline-primary">
        <i class="fa fa-random" aria-hidden="true"></i> Losuj element
    </button>
</div>
<p id="search-result" class="mt-3" aria-live="polite"></p>