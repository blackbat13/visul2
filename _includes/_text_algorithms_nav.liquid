<nav class="navbar navbar-expand-lg navbar-light bg-light ps-2">
    <div class="container-fluid">
        <a class="navbar-brand" href="{% if locale == 'en' %}{{ '/en/' | url }}{% else %}{{ '/' | url }}{% endif %}">Visul2</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="{{ copy.toggleNavigation }}">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                {% for item in copy.textAlgorithms %}
                <li class="nav-item">
                    <a class="nav-link {% if item.id == name %}active{% endif %}" href="../{{ item.id }}/">{{ item.name }}</a>
                </li>
                {% endfor %}
            </ul>
        </div>
        <a class="simulation-language-switch" href="{% if locale == 'pl' %}{{ page.url | prepend: '/en' | url }}{% else %}{{ page.url | remove_first: '/en' | url }}{% endif %}" lang="{% if locale == 'pl' %}en{% else %}pl{% endif %}" aria-label="{{ copy.languageLabel }}">{{ copy.languageName }}</a>
    </div>
</nav>
