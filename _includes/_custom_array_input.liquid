<div class="col-12">
    <label for="custom-array-input" class="form-label">Własna tablica (2–15 liczb z zakresu 0–999, oddzielonych spacją lub przecinkiem, separator dziesiętny: kropka):</label>
    <div class="input-group">
        <input id="custom-array-input" type="text" class="form-control" placeholder="np. 5 3.5 12 0.25 8" autocomplete="off"/>
        <button id="custom-array-button" type="button" class="btn btn-primary">Użyj tablicy</button>
    </div>
    <div id="custom-array-error" class="text-danger small mt-1" aria-live="polite"></div>
</div>
