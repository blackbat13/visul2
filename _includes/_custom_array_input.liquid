<div class="col-12">
    <label for="custom-array-input" class="form-label">{{ copy.labels.customArray }}</label>
    <div class="input-group">
        <input id="custom-array-input" type="text" class="form-control" placeholder="{{ copy.labels.customArrayPlaceholder }}" autocomplete="off"/>
        <button id="custom-array-button" type="button" class="btn btn-primary">{{ copy.labels.useArray }}</button>
    </div>
    <div id="custom-array-error" class="text-danger small mt-1" aria-live="polite"></div>
</div>
