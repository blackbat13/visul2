<h1 class="text-center">{{ copy.labels.settings }}</h1>
<form class="row g-3 mt-5">
    <div class="row col-12">
        <label for="size-input" class="col-8 col-form-label">{{ copy.labels.arraySize }}</label>
        <div class="col-4">
            <input id="size-input" type="number" class="form-control" min="2" max="15" step="1" value="10"/>
        </div>
    </div>
    <div class="col-4">
        <button id="prep-random-array-button" type="button" class="btn btn-primary">{{ copy.labels.randomArray }}</button>
    </div>
    <div class="col-4">
        <button id="prep-random-order-button" type="button" class="btn btn-primary">{{ copy.labels.randomOrder }}</button>
    </div>
    <div class="col-4">
        <button id="prep-reverse-order-button" type="button" class="btn btn-primary">{{ copy.labels.reverseOrder }}</button>
    </div>
    {% include "_custom_array_input.liquid" %}
</form>
