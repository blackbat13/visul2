<script>
    $(document).ready(function () {
        let algorithms = new DynamicAlgorithms();
        let $firstInput = $("#lcs-first-input");
        let $secondInput = $("#lcs-second-input");

        function prepareSimulation() {
            algorithms.prepareLongestCommonSubsequence($firstInput.val(), $secondInput.val());
        }

        renderPseudocode();
        prepareSimulation();
        algorithms.bindControls();

        $("#apply-lcs-button").click(prepareSimulation);
        $firstInput.add($secondInput).on("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                prepareSimulation();
            }
        });
    });
</script>
