<script>
    $(document).ready(function () {
        let searching = new Searching();
        searching.boundType = "{{ bound }}";
        if ("{{ alg }}" === "prepareTernarySearch") {
            searching.barHeadroom = 230;
        }
        let $prepRandomArrayButton = $("#prep-random-array-button");
        let $prepRandomOrderButton = $("#prep-random-order-button");
        let $prepReverseOrderButton = $("#prep-reverse-order-button");
        let $sizeInput = $("#size-input");
        let $searchTarget = $("#search-target");

        function prepareSimulation(randomizeTarget) {
            if ("{{ alg }}" === "prepareBinarySearch" || "{{ alg }}" === "prepareJumpSearch" || "{{ alg }}" === "prepareExponentialSearch" || "{{ alg }}" === "prepareFibonacciSearch" || "{{ alg }}" === "prepareTernarySearch") {
                searching.array.sort(function (a, b) { return a - b; });
            }

            searching.showArray();
            if ($searchTarget.length) {
                if (randomizeTarget) {
                    searching.randomizeSearchTarget();
                }
                searching.{{ alg }}();
            } else {
                searching.{{ alg }}();
            }
        }

        renderPseudocode();

        searching.loadOrPrepareArray();
        prepareSimulation($searchTarget.length > 0);
        searching.bindControls();

        searching.bindCustomArray(function () {
            prepareSimulation($searchTarget.length > 0);
        });
        $prepRandomArrayButton.click(function () {
            searching.prepareRandomArray($sizeInput.val());
            prepareSimulation($searchTarget.length > 0);
        });

        $prepRandomOrderButton.click(function () {
            searching.prepareRandomOrder($sizeInput.val());
            prepareSimulation($searchTarget.length > 0);
        });

        $prepReverseOrderButton.click(function () {
            searching.prepareReverseOrder($sizeInput.val());
            prepareSimulation($searchTarget.length > 0);
        });

        $searchTarget.on("change", function () {
            if (this.checkValidity()) {
                prepareSimulation(false);
            }
        });

        $("#random-search-target-button").click(function () {
            searching.randomizeSearchTarget();
            prepareSimulation(false);
        });
    });
</script>
