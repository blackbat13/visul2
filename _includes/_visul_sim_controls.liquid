<button id="start-button" type="button" class="btn btn-primary" aria-label="{{ copy.labels.play }}" title="{{ copy.labels.play }}"><i class="fa fa-play" aria-hidden="true"></i></button>
<button id="pause-button" type="button" class="btn btn-primary" aria-label="{{ copy.labels.pause }}" title="{{ copy.labels.pause }}"><i class="fa fa-pause" aria-hidden="true"></i></button>
<button id="restart-button" type="button" class="btn btn-primary" aria-label="{{ copy.labels.restart }}" title="{{ copy.labels.restart }}"><i class="fa fa-refresh" aria-hidden="true"></i></button>
<input id="time-range" class="form-range" type="range" min="0" max="100" step=".001" value="0" aria-label="{{ copy.labels.timeline }}"/>
<button id="export-slides-button" type="button" class="btn btn-outline-primary"><i class="fa fa-file-pdf-o" aria-hidden="true"></i> {{ copy.labels.exportSlides }}</button>
