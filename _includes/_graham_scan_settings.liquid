<div class="row col-12 mt-3">
    <label for="graham-point-count-input" class="col-12 col-form-label">{{ copy.labels.grahamPointCount }}</label>
    <div class="col-12">
        <input id="graham-point-count-input" type="number" class="form-control" min="3" max="16" step="1" value="12"/>
    </div>
</div>
<div class="row col-12 mt-3">
    <label for="graham-points-input" class="col-12 col-form-label">{{ copy.labels.grahamPoints }}</label>
    <div class="col-12">
        <textarea id="graham-points-input" class="form-control" rows="4" maxlength="256">1, 2; 2, 8; 4, 5; 5, 11; 7, 7; 10, 10; 11, 4; 10, 1; 6, 2; 3, 3; 8, 5; 5, 8</textarea>
    </div>
</div>
<p class="mt-2 mb-0">{{ copy.labels.grahamPointsHelp }}</p>
<div class="col-12 mt-2">
    <button id="randomize-graham-points-button" type="button" class="btn btn-outline-primary">
        <i class="fa fa-random" aria-hidden="true"></i> {{ copy.labels.randomizeGrahamPoints }}
    </button>
</div>
<p id="search-result" class="mt-3" aria-live="polite"></p>
