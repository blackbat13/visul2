<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ copy.description }}">
    <title>{{ copy.title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="{{ '/node_modules/bootstrap/dist/css/bootstrap.min.css' | url }}"/>
    <link rel="stylesheet" type="text/css" href="{{ '/assets/css/main.css' | url }}"/>
    <link rel="stylesheet" type="text/css" href="{{ '/assets/css/home.css' | url }}"/>
</head>
<body class="home-page">
<header class="home-header">
    <a class="home-brand" href="{{ '/' | url }}" aria-label="{{ copy.brandLabel }}">
        <span class="home-brand-mark">V2</span>
        <span>Visul2</span>
    </a>
    <nav class="home-nav" aria-label="{{ copy.navLabel }}">
        <a href="#algorithms">{{ copy.navAlgorithms }}</a>
        <a href="#about">{{ copy.navAbout }}</a>
    </nav>
    <div class="home-header-actions">
        <a class="home-language-switch" href="{% if locale == 'pl' %}{{ '/en/' | url }}{% else %}{{ '/' | url }}{% endif %}" lang="{% if locale == 'pl' %}en{% else %}pl{% endif %}" aria-label="{{ copy.languageLabel }}">
            {{ copy.languageName }}
        </a>
        <span class="home-header-note">{{ copy.headerNote }}</span>
    </div>
</header>

<main>
    <section class="home-hero" aria-labelledby="hero-title">
        <div class="home-hero-inner">
            <div class="hero-copy">
                <p class="hero-kicker"><span class="hero-kicker-dot"></span> {{ copy.heroLabel }}</p>
                <h1 id="hero-title">Visul<span>2</span></h1>
                <p class="hero-description">{{ copy.heroDescription }}</p>
                <a class="hero-cta" href="#algorithms">
                    {{ copy.heroCta }}
                    <span aria-hidden="true">&#8595;</span>
                </a>
                <p class="hero-footnote"><span>01</span> {{ copy.sortingStep }} &nbsp; <span>02</span> {{ copy.searchingStep }} &nbsp; <span>03</span> {{ copy.treesStep }} &nbsp; <span>04</span> {{ copy.backtrackingStep }}</p>
            </div>

            <figure class="algorithm-scene" aria-label="{{ copy.sceneChartLabel }}">
                <div class="scene-heading">
                    <span class="scene-label">{{ copy.sceneLabel }}</span>
                    <span class="scene-status"><span></span> {{ copy.sceneStatus }}</span>
                </div>
                <div class="scene-chart" role="img" aria-label="{{ copy.sceneChartLabel }}">
                    <div class="chart-baseline"></div>
                    <div class="chart-bars" aria-hidden="true">
                        <div class="chart-bar" style="--bar-size: 74%"><span>8</span><i></i></div>
                        <div class="chart-bar" style="--bar-size: 33%"><span>3</span><i></i></div>
                        <div class="chart-bar is-active" style="--bar-size: 58%"><span>6</span><i></i></div>
                        <div class="chart-bar is-compare" style="--bar-size: 24%"><span>2</span><i></i></div>
                        <div class="chart-bar" style="--bar-size: 66%"><span>7</span><i></i></div>
                        <div class="chart-bar" style="--bar-size: 16%"><span>1</span><i></i></div>
                        <div class="chart-bar" style="--bar-size: 49%"><span>5</span><i></i></div>
                        <div class="chart-bar" style="--bar-size: 41%"><span>4</span><i></i></div>
                    </div>
                </div>
                <figcaption class="scene-caption">
                    <span><i class="legend-dot legend-current"></i> {{ copy.currentElement }}</span>
                    <span><i class="legend-dot legend-compare"></i> {{ copy.comparison }}</span>
                    <span class="scene-caption-index">A[2] &gt; A[3]</span>
                </figcaption>
            </figure>
        </div>
        <div class="hero-coordinate" aria-hidden="true">52&deg;13' N<br>21&deg;00' E</div>
    </section>

    <section class="algorithm-directory" id="algorithms" aria-labelledby="directory-title">
        <div class="directory-heading">
            <p class="section-kicker">{{ copy.directoryKicker }}</p>
            <h2 id="directory-title">{{ copy.directoryTitleFirst }}<br>{{ copy.directoryTitleSecond }}</h2>
            <p class="directory-intro">{{ copy.directoryIntro }}</p>
        </div>

        <div class="directory-groups">
            <section class="directory-group" aria-labelledby="sorting-title">
                <div class="group-heading">
                    <span class="group-index">01</span>
                    <div>
                        <h3 id="sorting-title">{{ copy.sortingTitle }}</h3>
                        <p>{{ copy.sortingCount }}</p>
                    </div>
                    <span class="group-symbol sorting-symbol" aria-hidden="true">&#8645;</span>
                </div>
                <ul class="algorithm-list">
                    {% for item in copy.sorting %}
                    <li><a href="{% if locale == 'en' %}{{ item.href | prepend: '/en' | url }}{% else %}{{ item.href | url }}{% endif %}">{{ item.name }}{% if item.badge %} <em class="new-badge">{{ copy.newBadge }}</em>{% endif %} <span>&#8599;</span></a></li>
                    {% endfor %}
                </ul>
            </section>

            <section class="directory-group" aria-labelledby="searching-title">
                <div class="group-heading">
                    <span class="group-index">02</span>
                    <div>
                        <h3 id="searching-title">{{ copy.searchingTitle }}</h3>
                        <p>{{ copy.searchingCount }}</p>
                    </div>
                    <span class="group-symbol searching-symbol" aria-hidden="true">&#8981;</span>
                </div>
                <ul class="algorithm-list">
                    {% for item in copy.searching %}
                    <li><a href="{% if locale == 'en' %}{{ item.href | prepend: '/en' | url }}{% else %}{{ item.href | url }}{% endif %}">{{ item.name }}{% if item.badge %} <em class="new-badge">{{ copy.newBadge }}</em>{% endif %} <span>&#8599;</span></a></li>
                    {% endfor %}
                </ul>
            </section>

            <section class="directory-group" aria-labelledby="trees-title">
                <div class="group-heading">
                    <span class="group-index">03</span>
                    <div>
                        <h3 id="trees-title">{{ copy.treesTitle }}</h3>
                        <p>{{ copy.treesCount }}</p>
                    </div>
                    <span class="group-symbol trees-symbol" aria-hidden="true">&#9698;</span>
                </div>
                <ul class="algorithm-list">
                    {% for item in copy.trees %}
                    <li><a href="{% if locale == 'en' %}{{ item.href | prepend: '/en' | url }}{% else %}{{ item.href | url }}{% endif %}">{{ item.name }} <span>&#8599;</span></a></li>
                    {% endfor %}
                </ul>
            </section>

            <section class="directory-group" aria-labelledby="backtracking-title">
                <div class="group-heading">
                    <span class="group-index">04</span>
                    <div>
                        <h3 id="backtracking-title">{{ copy.backtrackingTitle }}</h3>
                        <p>{{ copy.backtrackingCount }}</p>
                    </div>
                    <span class="group-symbol backtracking-symbol" aria-hidden="true">&#8634;</span>
                </div>
                <ul class="algorithm-list">
                    {% for item in copy.backtracking %}
                    <li><a href="{% if locale == 'en' %}{{ item.href | prepend: '/en' | url }}{% else %}{{ item.href | url }}{% endif %}">{{ item.name }}{% if item.badge %} <em class="new-badge">{{ copy.newBadge }}</em>{% endif %} <span>&#8599;</span></a></li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </section>

    <section class="home-note" id="about" aria-label="{{ copy.aboutLabel }}">
        <span class="note-mark">V2</span>
        <p>{{ copy.aboutText }}</p>
        <span class="note-meta">VISUL2 / 2026</span>
    </section>
</main>

<script src="{{ '/node_modules/jquery/dist/jquery.min.js' | url }}"></script>
<script src="{{ '/node_modules/bootstrap/dist/js/bootstrap.min.js' | url }}"></script>
</body>
</html>
