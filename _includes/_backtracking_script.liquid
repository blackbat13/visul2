<script>
    $(document).ready(function () {
        let backtracking = new Backtracking();

        renderPseudocode();
        if ("{{ name }}" === "n_queens") {
            let $queenSize = $("#queen-size");
            backtracking.prepareNQueens(parseInt($queenSize.val(), 10));
            $queenSize.on("change", function () {
                backtracking.prepareNQueens(parseInt($queenSize.val(), 10));
            });
        } else {
            backtracking.prepareKnightsTour();
        }
        backtracking.bindControls();
    });
</script>
